---
const {
  image,
  title,
  subtitle,
  buttonText,
  buttonHref,
} = Astro.props;
---

<section class="hero" aria-label={title}>
  <!-- Background image -->
  <div class="hero__bg" style={`background-image: url('${image}')`} aria-hidden="true"></div>

  <!-- Dark overlay -->
  <div class="hero__overlay" aria-hidden="true"></div>

  <!-- Content -->
  <div class="hero__content container">
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {buttonText && buttonHref && (
      <a href={buttonHref} class="hero__btn" aria-label={buttonText}>
        {buttonText}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3v10M3 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 95svh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.03); /* slight scale-in room for hover effect */
    transition: transform 8s ease;
  }

  /* Ken Burns on load */
  .hero:hover .hero__bg,
  .hero__bg {
    animation: kenburns 18s ease-in-out infinite alternate;
  }

  @keyframes kenburns {
    from { transform: scale(1.03) translate(0, 0); }
    to   { transform: scale(1.08) translate(-1%, -0.5%); }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(15, 12, 8, 0.35) 0%,
      rgba(15, 12, 8, 0.55) 60%,
      rgba(15, 12, 8, 0.70) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__title {
    color: var(--color-white);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5.5vw, 5rem);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1.15;
    max-width: 16em;
    text-shadow: 0 2px 24px rgba(0,0,0,0.4);
    animation: fadeUp 0.9s ease both;
  }

  .hero__subtitle {
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    max-width: 40ch;
    animation: fadeUp 0.9s 0.15s ease both;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.75rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    transition: background var(--transition-base), border-color var(--transition-base), color var(--transition-base);
    animation: fadeUp 0.9s 0.3s ease both;
  }

  .hero__btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.8);
  }

  .hero__btn svg {
    animation: bounce 2s 1.5s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(4px); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
