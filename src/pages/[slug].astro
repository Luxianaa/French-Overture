---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { movements } from '../data/movements.js';
import defaultHeroImg from '../assets/hero-home.jpg';

export function getStaticPaths() {
  return movements.map((m) => {
    const slugKey = m.slug.replace(/^\//, '');
    return {
      params: { slug: slugKey },
      props: { movement: m },
    };
  });
}

const { movement } = Astro.props;
const { slug } = Astro.params;

// Discover content files dynamically without touching template
const contentModules = import.meta.glob('../data/content/*.js', { eager: true });
const contentFilePath = `../data/content/${slug}.js`;
const movementContent = contentModules[contentFilePath]?.content || null;

const heroImage = movementContent?.heroImage || defaultHeroImg.src;
const heroTitle = `${movement.number}. ${movementContent?.title || movement.title}`;
const pageTitle = `${movement.title} — French Overture`;
const pageDescription = movementContent?.introduction
  ? movementContent.introduction.replace(/\s+/g, ' ').trim().slice(0, 160) + '...'
  : `${movement.title} (Movement ${movement.number}) from Bach's French Overture BWV 831.`;

const currentMovementIndex = movements.findIndex((m) => m.slug === movement.slug || m.slug === `/${slug}`);
const prevMovement = currentMovementIndex > 0 ? movements[currentMovementIndex - 1] : null;
const nextMovement = currentMovementIndex >= 0 && currentMovementIndex < movements.length - 1 ? movements[currentMovementIndex + 1] : null;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Hero propio del movimiento -->
  <Hero
    image={heroImage}
    title={heroTitle}
    subtitle="French Overture in B minor, BWV 831"
  />

  {movementContent && movementContent.subsections?.length > 0 ? (
    <section class="section container movement-container" id="movement-content">
      {/* 2. Concepto general (introduction) */}
      <div class="movement-intro">
        <span class="movement-intro__label">General Concept</span>
        <p class="movement-intro__text">{movementContent.introduction}</p>
      </div>

      {/* 3. Subsecciones como PESTAÑAS (solo si hay más de una subsección) */}
      <div class="tabs-wrapper" id="tabs-root">
        {movementContent.subsections.length > 1 && (
          <div class="tablist-bar">
            <div
              role="tablist"
              class="tablist"
              aria-label={`${movement.title} subsections`}
            >
              {movementContent.subsections.map((sub, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${sub.id}`}
                  class={`tab-button ${index === 0 ? 'is-active' : ''}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`panel-${sub.id}`}
                  tabindex={index === 0 ? 0 : -1}
                  data-target={sub.id}
                >
                  {sub.title}
                </button>
              ))}
            </div>

            {/* Botones Previous / Next para navegar entre movimientos */}
            {(prevMovement || nextMovement) && (
              <div class="tab-nav-controls" aria-label="Movement navigation">
                {prevMovement && (
                  <a
                    href={prevMovement.slug}
                    class="tab-nav-btn"
                    aria-label={`Previous movement: ${prevMovement.title}`}
                  >
                    ← Previous: {prevMovement.title}
                  </a>
                )}
                {nextMovement && (
                  <a
                    href={nextMovement.slug}
                    class="tab-nav-btn"
                    aria-label={`Next movement: ${nextMovement.title}`}
                  >
                    Next: {nextMovement.title} →
                  </a>
                )}
              </div>
            )}
          </div>
        )}

        {/* 4. Paneles (Astro renderiza TODOS en el HTML con hidden) */}
        <div class="panels-container">
          {movementContent.subsections.map((sub, index) => {
            const activeExperiments = sub.experiments?.filter((exp) => Boolean(exp.youtubeId)) || [];

            return (
              <div
                role="tabpanel"
                id={`panel-${sub.id}`}
                aria-labelledby={`tab-${sub.id}`}
                class="tabpanel"
                hidden={index !== 0}
                data-panel-id={sub.id}
                tabindex="0"
              >
                <header class="panel-header">
                  <span class="panel-eyebrow">
                    {movementContent.subsections.length > 1
                      ? `Part ${index + 1} of ${movementContent.subsections.length}`
                      : 'Complete Movement'}
                  </span>
                  <h2 class="panel-title">{sub.title}</h2>
                  <p class="panel-question">{sub.question}</p>
                </header>

                {activeExperiments.length > 0 ? (
                  <div class="experiments-stack">
                    {activeExperiments.map((exp, expIdx) => {
                      const numStr = String(expIdx + 1).padStart(2, '0');
                      const rawInst = exp.instrument || 'piano';
                      const instCap = rawInst.charAt(0).toUpperCase() + rawInst.slice(1);
                      const defaultBadge = exp.version
                        ? `${numStr} — ${instCap} / Version ${exp.version}`
                        : (exp.type ? `${numStr} — ${exp.type.charAt(0).toUpperCase() + exp.type.slice(1)}` : numStr);
                      const badgeLabel = exp.badge || defaultBadge;
                      const dotClass = exp.type ? `type-dot--${exp.type}` : 'type-dot--neutral';

                      return (
                        <article class="experiment-card" aria-labelledby={`exp-title-${sub.id}-${expIdx}`}>
                          <header class="experiment-header">
                            <div class="experiment-badge">
                              <span class={`type-dot ${dotClass}`} aria-hidden="true"></span>
                              <span class="type-label">{badgeLabel}</span>
                            </div>
                            <h3 id={`exp-title-${sub.id}-${expIdx}`} class="experiment-title">
                              {exp.title}
                            </h3>
                          </header>

                          {/* Fila de 2 columnas: VÍDEO a la izquierda y carrusel a la derecha */}
                          <div class="experiment-row">
                            {/* Columna izquierda: Vídeo con carga diferida */}
                            <div class="lazy-video" data-youtube-id={exp.youtubeId}>
                              <button
                                type="button"
                                class="video-play-btn"
                                aria-label={`Play video: ${exp.title}`}
                                data-title={exp.title}
                              >
                                <img
                                  src={`https://img.youtube.com/vi/${exp.youtubeId}/hqdefault.jpg`}
                                  alt={`Thumbnail for ${exp.title}`}
                                  loading="lazy"
                                  class="video-thumbnail"
                                />
                                <div class="video-play-overlay">
                                  <span class="play-icon-circle">
                                    <svg
                                      class="play-svg"
                                      viewBox="0 0 24 24"
                                      width="20"
                                      height="20"
                                      fill="currentColor"
                                      aria-hidden="true"
                                    >
                                      <polygon points="6 4 20 12 6 20 6 4" />
                                    </svg>
                                  </span>
                                </div>
                              </button>
                            </div>

                            {/* Columna derecha: Carrusel de imágenes del experimento o recuadro de reserva */}
                            {exp.images && exp.images.length > 0 ? (
                              <div
                                class="carousel"
                                aria-roledescription="carousel"
                                aria-label={`Images for ${exp.title}`}
                              >
                                <div
                                  class="carousel__track"
                                  tabindex="0"
                                  role="region"
                                  aria-label={`Image gallery for ${exp.title}`}
                                >
                                  {exp.images.map((img, imgIdx) => (
                                    <div
                                      class="carousel__slide"
                                      role="group"
                                      aria-roledescription="slide"
                                      aria-label={`${imgIdx + 1} of ${exp.images.length}`}
                                    >
                                      <button
                                        type="button"
                                        class="carousel__image-btn"
                                        aria-label={`View ${img.caption || img.alt || `image ${imgIdx + 1}`}`}
                                        data-src={img.src}
                                        data-alt={img.alt}
                                        data-caption={img.caption}
                                        data-explanation={img.explanation}
                                        data-credit={img.credit || ''}
                                      >
                                        <img
                                          src={img.src}
                                          alt={img.alt}
                                          loading="lazy"
                                          class="carousel__img"
                                        />
                                        <span class="carousel__zoom-hint" aria-hidden="true">
                                          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                                            <circle cx="11" cy="11" r="7"/>
                                            <line x1="16.5" y1="16.5" x2="21" y2="21"/>
                                            <line x1="11" y1="8" x2="11" y2="14"/>
                                            <line x1="8" y1="11" x2="14" y2="11"/>
                                          </svg>
                                        </span>
                                      </button>
                                      {img.caption && (
                                        <div class="carousel__caption-bar" aria-hidden="true">
                                          <span class="carousel__caption-text">{img.caption}</span>
                                        </div>
                                      )}
                                    </div>
                                  ))}
                                </div>

                                {/* Controles de navegación y contador "1 / 2" */}
                                {exp.images.length > 1 && (
                                  <div class="carousel__controls" aria-label="Carousel navigation">
                                    <button
                                      type="button"
                                      class="carousel__nav-btn carousel__nav-btn--prev"
                                      aria-label="Previous image"
                                    >
                                      ←
                                    </button>
                                    <span class="carousel__counter" aria-live="polite" aria-atomic="true">
                                      1 / {exp.images.length}
                                    </span>
                                    <button
                                      type="button"
                                      class="carousel__nav-btn carousel__nav-btn--next"
                                      aria-label="Next image"
                                    >
                                      →
                                    </button>
                                  </div>
                                )}
                              </div>
                            ) : (
                              <div class="carousel-placeholder" aria-label="Reference image to be added">
                                <span class="carousel-placeholder__text">Reference image to be added</span>
                              </div>
                            )}
                          </div>

                          {/* Si hay description, va debajo de la fila */}
                          {exp.description && (
                            <p class="experiment-description">{exp.description}</p>
                          )}
                        </article>
                      );
                    })}
                  </div>
                ) : (
                  <div class="panel-empty">
                    <p class="panel-empty-text">Content coming soon</p>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ) : (
    <section class="section container coming-soon-section">
      <div class="coming-soon-card">
        <span class="coming-soon-label">Movement {movement.number}</span>
        <h2 class="coming-soon-title">{movement.title}</h2>
        <p class="coming-soon-text">Content coming soon</p>
      </div>
    </section>
  )}

  <!-- Lightbox Dialog (único para toda la página) -->
  <dialog
    id="lightbox-dialog"
    class="lightbox"
    aria-labelledby="lightbox-caption"
    aria-describedby="lightbox-explanation"
  >
    <div class="lightbox__container">
      <button
        type="button"
        id="lightbox-close-btn"
        class="lightbox__close-btn"
        aria-label="Close dialog"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <div class="lightbox__body">
        {/* Imagen agrandada a la izquierda con controles de navegación */}
        <div class="lightbox__media">
          <button
            type="button"
            id="lightbox-prev-btn"
            class="lightbox__nav-btn lightbox__nav-btn--prev"
            aria-label="Previous image"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>

          <img
            id="lightbox-img"
            src=""
            alt=""
            class="lightbox__img"
          />

          <button
            type="button"
            id="lightbox-next-btn"
            class="lightbox__nav-btn lightbox__nav-btn--next"
            aria-label="Next image"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>

          <span
            id="lightbox-counter"
            class="lightbox__counter"
            aria-live="polite"
            aria-atomic="true"
          ></span>
        </div>

        {/* Caption y Explanation a la derecha */}
        <div class="lightbox__info">
          <span class="lightbox__tag">Visual Analysis</span>
          <h2 id="lightbox-caption" class="lightbox__caption"></h2>
          <p id="lightbox-explanation" class="lightbox__explanation"></p>
          <div id="lightbox-meta" class="lightbox__meta" style="display: none;">
            <span id="lightbox-credit" class="lightbox__credit"></span>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  function setupTabs() {
    const tabsRoot = document.getElementById('tabs-root');
    if (!tabsRoot) return;

    const tabs = Array.from(tabsRoot.querySelectorAll('[role="tab"]'));
    const panels = Array.from(tabsRoot.querySelectorAll('[role="tabpanel"]'));
    const tablist = tabsRoot.querySelector('[role="tablist"]');

    if (!tabs.length || !panels.length) return;

    function getSubIdByIndex(idx) {
      return tabs[idx]?.getAttribute('data-target');
    }

    function getCurrentIndex() {
      return tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
    }

    // Stop and remove all active video iframes, restoring thumbnails
    function resetVideos() {
      const activeIframes = tabsRoot.querySelectorAll('.lazy-video iframe');
      activeIframes.forEach((iframe) => {
        const container = iframe.closest('.lazy-video');
        iframe.remove();
        if (container) {
          const btn = container.querySelector('.video-play-btn');
          if (btn) btn.style.display = '';
        }
      });
    }

    function activateTab(subId, setFocus = false) {
      let targetIndex = tabs.findIndex((tab) => tab.getAttribute('data-target') === subId);
      if (targetIndex === -1) targetIndex = 0;

      const activeSubId = getSubIdByIndex(targetIndex);

      // Reset any active video when switching tabs so audio stops immediately
      resetVideos();

      tabs.forEach((tab, idx) => {
        const isSelected = idx === targetIndex;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.setAttribute('tabindex', isSelected ? '0' : '-1');
        tab.classList.toggle('is-active', isSelected);
      });

      panels.forEach((panel) => {
        const matches = panel.getAttribute('data-panel-id') === activeSubId;
        panel.hidden = !matches;
      });

      // Update URL hash without jumping page scroll
      if (window.location.hash !== `#${activeSubId}`) {
        history.replaceState(null, '', `#${activeSubId}`);
      }

      if (setFocus) {
        tabs[targetIndex]?.focus();
      }
    }

    // Initialize lazy video click handlers
    const videoContainers = tabsRoot.querySelectorAll('.lazy-video');
    videoContainers.forEach((container) => {
      const playBtn = container.querySelector('.video-play-btn');
      if (!playBtn) return;

      playBtn.addEventListener('click', () => {
        const youtubeId = container.getAttribute('data-youtube-id');
        if (!youtubeId) return;

        // Create iframe ONLY when clicked
        const iframe = document.createElement('iframe');
        iframe.setAttribute(
          'src',
          `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`
        );
        iframe.setAttribute('title', playBtn.getAttribute('data-title') || 'YouTube video player');
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute(
          'allow',
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
        );
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.className = 'video-iframe';

        playBtn.style.display = 'none';
        container.appendChild(iframe);
      });
    });

    // Click handler for tab buttons
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const subId = tab.getAttribute('data-target');
        if (subId) activateTab(subId, false);
      });
    });



    // Keyboard navigation on tablist: Left / Right arrows
    tablist?.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const cur = tabs.indexOf(activeEl);
      if (cur === -1) return;

      let nextIdx = cur;
      if (e.key === 'ArrowRight') {
        nextIdx = (cur + 1) % tabs.length;
        e.preventDefault();
      } else if (e.key === 'ArrowLeft') {
        nextIdx = (cur - 1 + tabs.length) % tabs.length;
        e.preventDefault();
      } else if (e.key === 'Home') {
        nextIdx = 0;
        e.preventDefault();
      } else if (e.key === 'End') {
        nextIdx = tabs.length - 1;
        e.preventDefault();
      }

      if (nextIdx !== cur) {
        const subId = getSubIdByIndex(nextIdx);
        if (subId) activateTab(subId, true);
      }
    });

    // Synchronize with URL hash on load
    const currentHash = window.location.hash.replace('#', '');
    if (currentHash) {
      activateTab(currentHash, false);
    }

    // Handle browser back/forward with hash
    window.addEventListener('hashchange', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash) activateTab(hash, false);
    });
  }

  // ── 6. Image Carousel (scroll-snap, buttons, counter) ────
  function setupCarousels() {
    const carousels = document.querySelectorAll('.carousel');
    carousels.forEach((carousel) => {
      const track = carousel.querySelector('.carousel__track');
      const prevBtn = carousel.querySelector('.carousel__nav-btn--prev');
      const nextBtn = carousel.querySelector('.carousel__nav-btn--next');
      const counter = carousel.querySelector('.carousel__counter');
      const slides = carousel.querySelectorAll('.carousel__slide');
      const total = slides.length;

      if (!track || total <= 1) return;

      function updateCounter(index) {
        if (counter) {
          counter.textContent = `${index + 1} / ${total}`;
        }
      }

      function getCurrentIndex() {
        const slideWidth = track.clientWidth || 1;
        return Math.round(track.scrollLeft / slideWidth);
      }

      function scrollToSlide(index) {
        const slideWidth = track.clientWidth;
        track.scrollTo({
          left: index * slideWidth,
          behavior: 'smooth',
        });
        updateCounter(index);
      }

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const cur = getCurrentIndex();
        const prev = (cur - 1 + total) % total;
        scrollToSlide(prev);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const cur = getCurrentIndex();
        const next = (cur + 1) % total;
        scrollToSlide(next);
      });

      // Update counter on scroll
      let scrollTimer;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          updateCounter(getCurrentIndex());
        }, 40);
      }, { passive: true });

      // Keyboard navigation with left/right arrows on track
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          const cur = getCurrentIndex();
          scrollToSlide((cur + 1) % total);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          const cur = getCurrentIndex();
          scrollToSlide((cur - 1 + total) % total);
        }
      });
    });
  }

  // ── 7. Native Lightbox Dialog ───────────────────────────
  function setupLightbox() {
    const dialog = document.getElementById('lightbox-dialog');
    if (!dialog) return;

    const closeBtn = document.getElementById('lightbox-close-btn');
    const mediaContainer = dialog.querySelector('.lightbox__media');
    const lightboxImg = document.getElementById('lightbox-img');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');
    const counterEl = document.getElementById('lightbox-counter');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxExplanation = document.getElementById('lightbox-explanation');
    const lightboxMeta = document.getElementById('lightbox-meta');
    const lightboxCredit = document.getElementById('lightbox-credit');

    let triggerElement = null;
    let activeCarousel = null;
    let activeButtons = [];
    let currentIndex = 0;

    function preloadImage(src) {
      if (!src) return;
      const img = new Image();
      img.src = src;
    }

    function updateLightbox(index) {
      if (!activeButtons.length || index < 0 || index >= activeButtons.length) return;
      currentIndex = index;

      const btn = activeButtons[currentIndex];
      const src = btn.getAttribute('data-src') || '';
      const alt = btn.getAttribute('data-alt') || '';
      const caption = btn.getAttribute('data-caption') || '';
      const explanation = btn.getAttribute('data-explanation') || '';
      const credit = btn.getAttribute('data-credit') || '';
      const total = activeButtons.length;

      if (lightboxImg) {
        lightboxImg.src = src;
        lightboxImg.alt = alt || caption || 'Enlarged image';
      }
      if (lightboxCaption) {
        lightboxCaption.textContent = caption;
        lightboxCaption.style.display = caption ? '' : 'none';
      }
      if (lightboxExplanation) {
        lightboxExplanation.textContent = explanation;
        lightboxExplanation.style.display = explanation ? '' : 'none';
      }

      // Meta: credit only
      if (lightboxMeta) {
        if (credit) {
          lightboxMeta.style.display = 'block';
          if (lightboxCredit) lightboxCredit.textContent = credit;
        } else {
          lightboxMeta.style.display = 'none';
        }
      }

      if (total <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        if (counterEl) counterEl.style.display = 'none';
      } else {
        if (prevBtn) prevBtn.style.display = currentIndex > 0 ? '' : 'none';
        if (nextBtn) nextBtn.style.display = currentIndex < total - 1 ? '' : 'none';
        if (counterEl) {
          counterEl.style.display = '';
          counterEl.textContent = `${currentIndex + 1} / ${total}`;
        }
      }

      // Preload previous and next image
      if (currentIndex > 0) {
        preloadImage(activeButtons[currentIndex - 1].getAttribute('data-src'));
      }
      if (currentIndex < total - 1) {
        preloadImage(activeButtons[currentIndex + 1].getAttribute('data-src'));
      }
    }

    function showPrev() {
      if (currentIndex > 0) {
        updateLightbox(currentIndex - 1);
      }
    }

    function showNext() {
      if (currentIndex < activeButtons.length - 1) {
        updateLightbox(currentIndex + 1);
      }
    }

    // Attach click listener to all image buttons in carousels
    const imageButtons = document.querySelectorAll('.carousel__image-btn');
    imageButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        triggerElement = btn;
        activeCarousel = btn.closest('.carousel');
        activeButtons = activeCarousel
          ? Array.from(activeCarousel.querySelectorAll('.carousel__image-btn'))
          : [btn];

        const initialIdx = activeButtons.indexOf(btn);
        updateLightbox(initialIdx >= 0 ? initialIdx : 0);

        dialog.showModal();
      });
    });

    // Navigation buttons
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // Keyboard navigation within dialog: Left / Right arrows
    dialog.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        showPrev();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        showNext();
      }
    });

    // Touch swipe navigation on media container
    let touchStartX = 0;
    let touchStartY = 0;

    mediaContainer?.addEventListener('touchstart', (e) => {
      if (e.changedTouches.length === 1) {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }
    }, { passive: true });

    mediaContainer?.addEventListener('touchend', (e) => {
      if (e.changedTouches.length === 1) {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
          if (deltaX < 0) {
            showNext();
          } else {
            showPrev();
          }
        }
      }
    }, { passive: true });

    // Close button
    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    // Click outside dialog to close (backdrop click)
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.close();
      }
    });

    // Sync carousel and restore focus on close
    dialog.addEventListener('close', () => {
      if (activeCarousel && activeButtons.length > 1) {
        const track = activeCarousel.querySelector('.carousel__track');
        const carouselCounter = activeCarousel.querySelector('.carousel__counter');
        if (track) {
          const slideWidth = track.clientWidth || 1;
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          track.scrollTo({
            left: currentIndex * slideWidth,
            behavior: prefersReduced ? 'auto' : 'smooth',
          });
          if (carouselCounter) {
            carouselCounter.textContent = `${currentIndex + 1} / ${activeButtons.length}`;
          }
        }
      }

      if (triggerElement) {
        triggerElement.focus();
        triggerElement = null;
      }
      activeCarousel = null;
      activeButtons = [];
    });
  }

  // Run on initial load and page changes
  function initPage() {
    setupTabs();
    setupCarousels();
    setupLightbox();
  }

  initPage();
  document.addEventListener('astro:page-load', initPage);
</script>

