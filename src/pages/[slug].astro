---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { movements } from '../data/movements.js';
import defaultHeroImg from '../assets/hero-home.jpg';

export function getStaticPaths() {
  return movements.map((m) => {
    const slugKey = m.slug.replace(/^\//, '');
    return {
      params: { slug: slugKey },
      props: { movement: m },
    };
  });
}

const { movement } = Astro.props;
const { slug } = Astro.params;

// Discover content files dynamically without touching template
const contentModules = import.meta.glob('../data/content/*.js', { eager: true });
const contentFilePath = `../data/content/${slug}.js`;
const movementContent = contentModules[contentFilePath]?.content || null;

const heroImage = movementContent?.heroImage || defaultHeroImg.src;
const heroTitle = `${movement.number}. ${movementContent?.title || movement.title}`;
const pageTitle = `${movement.title} — French Overture`;
const pageDescription = movementContent?.introduction
  ? movementContent.introduction.replace(/\s+/g, ' ').trim().slice(0, 160) + '...'
  : `${movement.title} (Movement ${movement.number}) from Bach's French Overture BWV 831.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Hero propio del movimiento -->
  <Hero
    image={heroImage}
    title={heroTitle}
    subtitle="French Overture in B minor, BWV 831"
  />

  {movementContent && movementContent.subsections?.length > 0 ? (
    <section class="section container movement-container" id="movement-content">
      {/* 2. Concepto general (introduction) */}
      <div class="movement-intro">
        <span class="movement-intro__label">General Concept</span>
        <p class="movement-intro__text">{movementContent.introduction}</p>
      </div>

      {/* 3. Subsecciones como PESTAÑAS */}
      <div class="tabs-wrapper" id="tabs-root">
        <div class="tablist-bar">
          <div
            role="tablist"
            class="tablist"
            aria-label={`${movement.title} subsections`}
          >
            {movementContent.subsections.map((sub, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${sub.id}`}
                class={`tab-button ${index === 0 ? 'is-active' : ''}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`panel-${sub.id}`}
                tabindex={index === 0 ? 0 : -1}
                data-target={sub.id}
              >
                {sub.title}
              </button>
            ))}
          </div>

          {/* Botones Previous / Next */}
          <div class="tab-nav-controls" aria-label="Subsection navigation">
            <button
              type="button"
              id="prev-tab-btn"
              class="tab-nav-btn"
              aria-label="Previous subsection"
            >
              ← Previous
            </button>
            <button
              type="button"
              id="next-tab-btn"
              class="tab-nav-btn"
              aria-label="Next subsection"
            >
              Next →
            </button>
          </div>
        </div>

        {/* 4. Paneles (Astro renderiza TODOS en el HTML con hidden) */}
        <div class="panels-container">
          {movementContent.subsections.map((sub, index) => (
            <div
              role="tabpanel"
              id={`panel-${sub.id}`}
              aria-labelledby={`tab-${sub.id}`}
              class="tabpanel"
              hidden={index !== 0}
              data-panel-id={sub.id}
              tabindex="0"
            >
              <header class="panel-header">
                <span class="panel-eyebrow">
                  Part {index + 1} of {movementContent.subsections.length}
                </span>
                <h2 class="panel-title">{sub.title}</h2>
                <p class="panel-question">{sub.question}</p>
              </header>

              {/* 4 experimentos apilados uno bajo otro */}
              <div class="experiments-stack">
                {sub.experiments?.map((exp, expIdx) => {
                  const numStr = String(expIdx + 1).padStart(2, '0');
                  const typeLabel = exp.type
                    ? exp.type.charAt(0).toUpperCase() + exp.type.slice(1)
                    : '';

                  return (
                    <article class="experiment-card" aria-labelledby={`exp-title-${sub.id}-${expIdx}`}>
                      <header class="experiment-header">
                        <div class="experiment-badge">
                          <span class={`type-dot type-dot--${exp.type}`} aria-hidden="true"></span>
                          <span class="type-label">{numStr} — {typeLabel}</span>
                        </div>
                        <h3 id={`exp-title-${sub.id}-${expIdx}`} class="experiment-title">
                          {exp.title}
                        </h3>
                      </header>

                      {/* Fila de 2 columnas: VÍDEO a la izquierda y carrusel a la derecha */}
                      <div class="experiment-row">
                        {/* Columna izquierda: Vídeo con carga diferida */}
                        <div class="lazy-video" data-youtube-id={exp.youtubeId}>
                          <button
                            type="button"
                            class="video-play-btn"
                            aria-label={`Play video: ${exp.title}`}
                            data-title={exp.title}
                          >
                            <img
                              src={`https://img.youtube.com/vi/${exp.youtubeId}/hqdefault.jpg`}
                              alt={`Thumbnail for ${exp.title}`}
                              loading="lazy"
                              class="video-thumbnail"
                            />
                            <div class="video-play-overlay">
                              <span class="play-icon-circle">
                                <svg
                                  class="play-svg"
                                  viewBox="0 0 24 24"
                                  width="20"
                                  height="20"
                                  fill="currentColor"
                                  aria-hidden="true"
                                >
                                  <polygon points="6 4 20 12 6 20 6 4" />
                                </svg>
                              </span>
                            </div>
                          </button>
                        </div>

                        {/* Columna derecha: Espacio reservado para el carrusel */}
                        <div
                          class="carousel-placeholder"
                          aria-label="Carousel reserved slot"
                        >
                          <div class="carousel-placeholder__inner">
                            <span class="carousel-placeholder__tag">Visual Documentation</span>
                            <span class="carousel-placeholder__title">Comparative Analysis</span>
                            <p class="carousel-placeholder__caption">
                              {exp.images?.length > 0
                                ? `${exp.images.length} archival images ready`
                                : 'Archival images and scores'}
                            </p>
                          </div>
                        </div>
                      </div>

                      {/* Si hay description, va debajo de la fila */}
                      {exp.description && (
                        <p class="experiment-description">{exp.description}</p>
                      )}
                    </article>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section container coming-soon-section">
      <div class="coming-soon-card">
        <span class="coming-soon-label">Movement {movement.number}</span>
        <h2 class="coming-soon-title">{movement.title}</h2>
        <p class="coming-soon-text">Content coming soon</p>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  function setupTabs() {
    const tabsRoot = document.getElementById('tabs-root');
    if (!tabsRoot) return;

    const tabs = Array.from(tabsRoot.querySelectorAll('[role="tab"]'));
    const panels = Array.from(tabsRoot.querySelectorAll('[role="tabpanel"]'));
    const prevBtn = document.getElementById('prev-tab-btn');
    const nextBtn = document.getElementById('next-tab-btn');
    const tablist = tabsRoot.querySelector('[role="tablist"]');

    if (!tabs.length || !panels.length) return;

    function getSubIdByIndex(idx) {
      return tabs[idx]?.getAttribute('data-target');
    }

    function getCurrentIndex() {
      return tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
    }

    // Stop and remove all active video iframes, restoring thumbnails
    function resetVideos() {
      const activeIframes = tabsRoot.querySelectorAll('.lazy-video iframe');
      activeIframes.forEach((iframe) => {
        const container = iframe.closest('.lazy-video');
        iframe.remove();
        if (container) {
          const btn = container.querySelector('.video-play-btn');
          if (btn) btn.style.display = '';
        }
      });
    }

    function activateTab(subId, setFocus = false) {
      let targetIndex = tabs.findIndex((tab) => tab.getAttribute('data-target') === subId);
      if (targetIndex === -1) targetIndex = 0;

      const activeSubId = getSubIdByIndex(targetIndex);

      // Reset any active video when switching tabs so audio stops immediately
      resetVideos();

      tabs.forEach((tab, idx) => {
        const isSelected = idx === targetIndex;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.setAttribute('tabindex', isSelected ? '0' : '-1');
        tab.classList.toggle('is-active', isSelected);
      });

      panels.forEach((panel) => {
        const matches = panel.getAttribute('data-panel-id') === activeSubId;
        panel.hidden = !matches;
      });

      // Update URL hash without jumping page scroll
      if (window.location.hash !== `#${activeSubId}`) {
        history.replaceState(null, '', `#${activeSubId}`);
      }

      if (setFocus) {
        tabs[targetIndex]?.focus();
      }
    }

    // Initialize lazy video click handlers
    const videoContainers = tabsRoot.querySelectorAll('.lazy-video');
    videoContainers.forEach((container) => {
      const playBtn = container.querySelector('.video-play-btn');
      if (!playBtn) return;

      playBtn.addEventListener('click', () => {
        const youtubeId = container.getAttribute('data-youtube-id');
        if (!youtubeId) return;

        // Create iframe ONLY when clicked
        const iframe = document.createElement('iframe');
        iframe.setAttribute(
          'src',
          `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`
        );
        iframe.setAttribute('title', playBtn.getAttribute('data-title') || 'YouTube video player');
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute(
          'allow',
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
        );
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.className = 'video-iframe';

        playBtn.style.display = 'none';
        container.appendChild(iframe);
      });
    });

    // Click handler for tab buttons
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const subId = tab.getAttribute('data-target');
        if (subId) activateTab(subId, false);
      });
    });

    // Previous / Next buttons
    prevBtn?.addEventListener('click', () => {
      const cur = getCurrentIndex();
      const prevIdx = (cur - 1 + tabs.length) % tabs.length;
      const subId = getSubIdByIndex(prevIdx);
      if (subId) activateTab(subId, false);
    });

    nextBtn?.addEventListener('click', () => {
      const cur = getCurrentIndex();
      const nextIdx = (cur + 1) % tabs.length;
      const subId = getSubIdByIndex(nextIdx);
      if (subId) activateTab(subId, false);
    });

    // Keyboard navigation on tablist: Left / Right arrows
    tablist?.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const cur = tabs.indexOf(activeEl);
      if (cur === -1) return;

      let nextIdx = cur;
      if (e.key === 'ArrowRight') {
        nextIdx = (cur + 1) % tabs.length;
        e.preventDefault();
      } else if (e.key === 'ArrowLeft') {
        nextIdx = (cur - 1 + tabs.length) % tabs.length;
        e.preventDefault();
      } else if (e.key === 'Home') {
        nextIdx = 0;
        e.preventDefault();
      } else if (e.key === 'End') {
        nextIdx = tabs.length - 1;
        e.preventDefault();
      }

      if (nextIdx !== cur) {
        const subId = getSubIdByIndex(nextIdx);
        if (subId) activateTab(subId, true);
      }
    });

    // Synchronize with URL hash on load
    const currentHash = window.location.hash.replace('#', '');
    if (currentHash) {
      activateTab(currentHash, false);
    }

    // Handle browser back/forward with hash
    window.addEventListener('hashchange', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash) activateTab(hash, false);
    });
  }

  // Run on initial load and page changes
  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>

<style>
  /* ── Movement Layout ────────────────────────────────────── */
  .movement-container {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
    max-width: min(90%, 1100px);
    margin-inline: auto;
  }

  /* ── 2. Introduction / General Concept ──────────────────── */
  .movement-intro {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .movement-intro__label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .movement-intro__text {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.6;
    color: var(--color-ink);
    max-width: var(--measure-wide);
    font-style: italic;
  }

  /* ── 3. Tabs Navigation Bar ─────────────────────────────── */
  .tabs-wrapper {
    margin-top: var(--space-xl);
  }

  .tablist-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    border-bottom: 1px solid rgba(26, 23, 20, 0.12);
    padding-bottom: var(--space-xs);
    flex-wrap: wrap;
  }

  .tablist {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .tab-button {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.75rem 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .tab-button:hover {
    color: var(--color-ink);
    background-color: var(--color-cream-dark);
  }

  .tab-button.is-active {
    color: var(--color-ink);
    font-weight: 500;
    border-bottom-color: var(--color-ink);
    background-color: rgba(237, 229, 213, 0.4);
  }

  .tab-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Previous / Next buttons */
  .tab-nav-controls {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .tab-nav-btn {
    background: none;
    border: 1px solid rgba(26, 23, 20, 0.15);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .tab-nav-btn:hover {
    background: var(--color-cream-dark);
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .tab-nav-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── 4. Tab Panels ──────────────────────────────────────── */
  .panels-container {
    margin-top: var(--space-xl);
  }

  .tabpanel {
    outline: none;
  }

  .panel-header {
    background: var(--color-cream-dark);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    border: 1px solid rgba(26, 23, 20, 0.06);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .panel-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .panel-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    font-weight: 300;
    color: var(--color-ink);
    line-height: 1.15;
  }

  .panel-question {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: var(--measure);
    margin-top: var(--space-xs);
  }

  /* ── 5. Experiments Stack ───────────────────────────────── */
  .experiments-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .experiment-card {
    background: var(--color-cream);
    border: 1px solid rgba(26, 23, 20, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    box-shadow: 0 2px 12px rgba(26, 23, 20, 0.03);
    transition: box-shadow var(--transition-base);
  }

  .experiment-card:hover {
    box-shadow: 0 4px 20px rgba(26, 23, 20, 0.06);
  }

  .experiment-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .experiment-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .type-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .type-dot--structural {
    background-color: var(--type-structural);
  }

  .type-dot--rhetorical {
    background-color: var(--type-rhetorical);
  }

  .type-dot--extreme {
    background-color: var(--type-extreme);
  }

  .type-dot--harpsichord {
    background-color: var(--type-harpsichord);
  }

  .type-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .experiment-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.25;
  }

  /* ── Two-column row: Video | Carousel placeholder ───────── */
  .experiment-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: stretch;
  }

  /* ── Lazy Video ─────────────────────────────────────────── */
  .lazy-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(26, 23, 20, 0.1);
  }

  .video-play-btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    display: block;
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base), filter var(--transition-base);
  }

  .video-play-btn:hover .video-thumbnail {
    transform: scale(1.02);
    filter: brightness(0.92);
  }

  .video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 12, 8, 0.25);
    transition: background var(--transition-fast);
  }

  .video-play-btn:hover .video-play-overlay {
    background: rgba(15, 12, 8, 0.15);
  }

  .play-icon-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(245, 240, 232, 0.95);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: transform var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
  }

  .play-svg {
    margin-left: 2px; /* optical center */
  }

  .video-play-btn:hover .play-icon-circle {
    transform: scale(1.1);
    background: var(--color-white);
  }

  :global(.video-iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── Carousel Placeholder (Step 2 reserved slot) ────────── */
  .carousel-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-cream-dark);
    border: 1px dashed rgba(26, 23, 20, 0.18);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .carousel-placeholder__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .carousel-placeholder__tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .carousel-placeholder__title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-ink);
  }

  .carousel-placeholder__caption {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── Description below row ──────────────────────────────── */
  .experiment-description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: var(--measure-wide);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(26, 23, 20, 0.06);
  }

  /* ── Fallback: Coming soon ──────────────────────────────── */
  .coming-soon-section {
    padding-block: var(--space-2xl);
  }

  .coming-soon-card {
    text-align: center;
    background: var(--color-cream-dark);
    padding: var(--space-2xl) var(--space-xl);
    border-radius: var(--radius-md);
    border: 1px solid rgba(26, 23, 20, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .coming-soon-label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .coming-soon-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 300;
    color: var(--color-ink);
  }

  .coming-soon-text {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: var(--space-sm);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    .tablist-bar {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .tablist {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
