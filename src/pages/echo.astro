---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import heroImg from '../assets/hero-home.jpg';
---

<BaseLayout title="Echo — French Overture" description="Movement XI: Echo from Bach's French Overture BWV 831.">
  <Hero
    image={heroImg.src}
    title="XI. Echo"
    subtitle="French Overture in B minor, BWV 831"
  />

  <section class="section container stub-content">
    <p class="stub-label">Movement XI</p>
    <h2 class="stub-heading">Echo</h2>
    <p class="stub-body">
      This page is a placeholder. The full analysis, audio examples, and interpretive
      commentary for the Echo will appear here in a future version of this site.
    </p>
  </section>
</BaseLayout>

<style>
  .stub-content {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .stub-label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    max-width: none;
  }
  .stub-heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 300;
    color: var(--color-ink);
  }
  .stub-body {
    max-width: 55ch;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
  }
</style>
