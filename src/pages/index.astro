---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { movements } from '../data/movements.js';

import heroImg from '../assets/hero-home.jpg';
import portraitImg from '../assets/BACH.jpg';
---

<BaseLayout
  title="French Overture — A Laboratory of Doubt Against Automatic Bach"
  description="An editorial exploration of Bach's French Overture BWV 831, questioning interpretation, performance, and the myth of the definitive version."
>
  <!-- ── 1. HERO ────────────────────────────────────────────── -->
  <Hero
    image={heroImg.src}
    title="A Laboratory of Doubt Against Automatic Bach"
    buttonText="Explore"
    buttonHref="#intro"
  />

  <!-- ── 2. PORTRAIT + TEXT ────────────────────────────────── -->
  <section id="intro" class="section intro-section">
    <div class="container intro-section__inner">
      <figure class="intro-section__portrait">
        <img
          src={portraitImg.src}
          alt="Detail of a baroque harpsichord keyboard"
          width="420"
          height="630"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="intro-section__text">
        <h2 class="intro-section__heading">On doubt as a method</h2>
        <p>
          This project explores how intuition, training and familiar habits shape my 
          interpretation of Bach’s Ouverture nach französischer Art, BWV 831. I recorded
          contrasting versions before undertaking detailed historical and interpretative
          reading, then returned to those performances to reconsider my choices.
        </p>
        <p>
          This website brings together recordings, musical examples and reflections, inviting
          you to hear how changes in tempo, articulation, dynamics and sonority can reveal 
          different possibilities within the same passage. The accompanying essay, available 
          in the Library, explores what I learnt through this process and the questions it 
          raised about my own musical judgement.
        </p>
  
      </div>
    </div>
  </section>

  <!-- ── 3. MOVEMENTS GRID ─────────────────────────────────── -->
  <section class="section grid-section" aria-labelledby="movements-heading">
    <div class="container">
      <header class="grid-section__header">
        <h2 id="movements-heading" class="grid-section__title">Movements</h2>
        <p class="grid-section__sub">BWV 831 · French Overture in B minor</p>
      </header>

      <ol class="movements-grid" aria-label="List of movements">
        {movements.map((m) => (
          <li class="movements-grid__item">
            <a href={m.slug} class="movement-card" aria-label={`${m.title} — movement ${m.number}`}>
              <!-- Movement artwork image -->
              <div class="movement-card__media">
                <img
                  src={m.image}
                  alt={m.imageAlt || m.title}
                  class="movement-card__img"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="300"
                />
              </div>

              <div class="movement-card__body">
                <span class="movement-card__num" aria-hidden="true">{m.number}</span>
                <span class="movement-card__title">{m.title}</span>
                <span class="movement-card__arrow" aria-hidden="true">→</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Intro section ──────────────────────────────────────── */
  .intro-section {
    background: var(--color-cream);
    padding-block: var(--space-2xl);
  }

  .intro-section__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .intro-section__portrait {
    margin: 0;
    flex-shrink: 0;
  }

  .intro-section__portrait img {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 40px rgba(26, 23, 20, 0.12);
  }

  .intro-section__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-top: var(--space-sm);
  }

  .intro-section__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    font-weight: 300;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
  }

  .intro-section__text p {
    max-width: 60ch;
    line-height: 1.8;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
  }

  /* ── Grid section ───────────────────────────────────────── */
  .grid-section {
    background: var(--color-cream-dark);
    padding-block: var(--space-2xl);
  }

  .grid-section__header {
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .grid-section__title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 300;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .grid-section__sub {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-top: var(--space-sm);
    max-width: none;
  }

  /* Grid */
  .movements-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(26, 23, 20, 0.08);
    border: 1px solid rgba(26, 23, 20, 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .movements-grid__item {
    background: var(--color-cream);
  }

  /* Card */
  .movement-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: background var(--transition-fast);
  }

  .movement-card:hover {
    background: var(--color-cream-dark);
  }

  /* Card media & artwork image */
  .movement-card__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0d0b09;
    border-bottom: 1px solid rgba(26, 23, 20, 0.08);
    position: relative;
  }

  .movement-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .movement-card:hover .movement-card__img {
    transform: scale(1.04);
  }

  /* Card body */
  .movement-card__body {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 1rem 1.25rem;
    flex: 1;
  }

  .movement-card__num {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    min-width: 2ch;
    flex-shrink: 0;
  }

  .movement-card__title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--color-ink);
    flex: 1;
  }

  .movement-card__arrow {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .movement-card:hover .movement-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .movements-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .intro-section__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .intro-section__portrait {
      max-width: 240px;
      margin-inline: auto;
    }

    .intro-section__portrait img {
      max-width: 240px;
    }

    .movements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .movements-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .movement-card__img {
      transition: none !important;
    }

    .movement-card:hover .movement-card__img {
      transform: none !important;
    }
  }
</style>
