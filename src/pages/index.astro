---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { movements } from '../data/movements.js';

import heroImg from '../assets/hero-home.jpg';
import portraitImg from '../assets/BACH.jpg';
---

<BaseLayout
  title="French Ouverture — A Laboratory of Doubt Against Automatic Bach"
  description="An editorial exploration of Bach's French Ouverture BWV 831, questioning interpretation, performance, and the myth of the definitive version."
>
  <!-- ── 1. HERO ────────────────────────────────────────────── -->
  <Hero
    image={heroImg.src}
    title="A Laboratory of Doubt Against Automatic Bach"
    buttonText="Explore"
    buttonHref="#intro"
  />

  <!-- ── 2. PORTRAIT + TEXT ────────────────────────────────── -->
  <section id="intro" class="section intro-section">
    <div class="container intro-section__inner">
      <figure class="intro-section__portrait">
        <img
          src={portraitImg.src}
          alt="Detail of a baroque harpsichord keyboard"
          width="420"
          height="630"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="intro-section__text">
        <h2 class="intro-section__heading">Relearning the French Ouverture at the piano</h2>
        <p>
          This project explores how intuition, training and familiar habits shape my 
          interpretation of Bach’s Ouverture nach französischer Art, BWV 831. I recorded
          contrasting versions before undertaking detailed historical and interpretative
          reading, then returned to those performances to reconsider my choices.
        </p>
        <p>
          This website brings together recordings, musical examples and reflections, inviting
          you to hear how changes in tempo, articulation, dynamics and sonority can reveal 
          different possibilities within the same passage. The accompanying essay, available 
          in the Library, explores what I learnt through this process and the questions it 
          raised about my own musical judgement.
        </p>
  
      </div>
    </div>
  </section>

  <!-- ── HOW TO EXPLORE SECTION ────────────────────────────── -->
  <section id="how-to-explore" class="section how-section" aria-labelledby="how-heading">
    <div class="container">
      <header class="how-header">
        <span class="how-eyebrow">HOW IT WORKS</span>
        <h2 id="how-heading" class="how-title">How to explore this project</h2>
        <p class="how-subtitle">This site is a laboratory, not a thesis. Listen first, compare, then build your own version.</p>
      </header>

      <!-- Steps 01 to 05 -->
      <ol class="how-steps" aria-label="Steps to explore the project">
        <li class="how-step">
          <div class="how-step__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="14" y2="12"></line>
              <line x1="4" y1="18" x2="18" y2="18"></line>
            </svg>
          </div>
          <div class="how-step__meta">
            <span class="how-step__num">01</span>
            <span class="how-step__sep" aria-hidden="true">—</span>
            <h3 class="how-step__title">Choose a movement.</h3>
          </div>
          <p class="how-step__desc">Open the Laboratory menu and pick a dance. Each one is divided into sections: A, B, Fugue…</p>
        </li>

        <li class="how-step">
          <div class="how-step__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="6 4 20 12 6 20 6 4"></polygon>
            </svg>
          </div>
          <div class="how-step__meta">
            <span class="how-step__num">02</span>
            <span class="how-step__sep" aria-hidden="true">—</span>
            <h3 class="how-step__title">Listen and compare.</h3>
          </div>
          <p class="how-step__desc">Every section has several piano versions and one harpsichord take. Play them one after another and notice what changes.</p>
        </li>

        <li class="how-step">
          <div class="how-step__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
          <div class="how-step__meta">
            <span class="how-step__num">03</span>
            <span class="how-step__sep" aria-hidden="true">—</span>
            <h3 class="how-step__title">Look at the references.</h3>
          </div>
          <p class="how-step__desc">Beside each video you will find paintings and scores that inspired the choices. Click any image to enlarge it and read how it relates to the music.</p>
        </li>

        <li class="how-step">
          <div class="how-step__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="how-step__meta">
            <span class="how-step__num">04</span>
            <span class="how-step__sep" aria-hidden="true">—</span>
            <h3 class="how-step__title">Star your choice.</h3>
          </div>
          <p class="how-step__desc">Mark ★ one version per section. You can change it at any time; only one star per section.</p>
        </li>

        <li class="how-step">
          <div class="how-step__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8"></polygon>
            </svg>
          </div>
          <div class="how-step__meta">
            <span class="how-step__num">05</span>
            <span class="how-step__sep" aria-hidden="true">—</span>
            <h3 class="how-step__title">Hear your version.</h3>
          </div>
          <p class="how-step__desc">The Library gathers your choices, shows their paintings and plays them in order with "Play my version".</p>
        </li>
      </ol>

      <!-- Auxiliary 2-column block -->
      <div class="how-aux">
        <!-- Left: Your choices -->
        <div class="how-card">
          <span class="how-card__eyebrow">YOUR CHOICES</span>
          <h3 class="how-card__title">Your choices stay with you</h3>
          <p class="how-card__text">Stars are saved only in this browser. Nobody else sees them, and clearing your browser data erases them.</p>

          <div class="how-demo" aria-hidden="true">
            <div class="how-demo__row is-starred">
              <div class="how-demo__label">
                <span class="how-demo__pip" style="background-color: var(--type-rhetorical);"></span>
                <span class="how-demo__name">Version 2 </span>
              </div>
              <span class="how-demo__star">★</span>
            </div>
            <div class="how-demo__row">
              <div class="how-demo__label">
                <span class="how-demo__pip" style="background-color: var(--type-structural);"></span>
                <span class="how-demo__name">Version 1 </span>
              </div>
              <span class="how-demo__star">☆</span>
            </div>
          </div>
        </div>

        <!-- Right: Map of the site -->
        <div class="how-card how-card--map">
          <span class="how-card__eyebrow">MAP OF THE SITE</span>
          <ul class="how-map-list" aria-label="Site map navigation">
            <li class="how-map-item">
              <a href="/ouverture" class="how-map-link">
                <strong class="how-map-name">Laboratory</strong>
                <span class="how-map-dash" aria-hidden="true">—</span>
                <span class="how-map-desc">The dances, section by section, with their versions.</span>
              </a>
            </li>
            <li class="how-map-item">
              <a href="/gallery" class="how-map-link">
                <strong class="how-map-name">Gallery</strong>
                <span class="how-map-dash" aria-hidden="true">—</span>
                <span class="how-map-desc">Every painting of the project on a single wall.</span>
              </a>
            </li>
            <li class="how-map-item">
              <a href="/my-versions" class="how-map-link">
                <strong class="how-map-name">Daniel's versions</strong>
                <span class="how-map-dash" aria-hidden="true">—</span>
                <span class="how-map-desc">Three complete readings of the Ouverture.</span>
              </a>
            </li>
            <li class="how-map-item">
              <a href="/library" class="how-map-link">
                <strong class="how-map-name">My Library</strong>
                <span class="how-map-dash" aria-hidden="true">—</span>
                <span class="how-map-desc">Your final selection, and the way to listen to it.</span>
              </a>
            </li>
            <li class="how-map-item">
              <a href="/about" class="how-map-link">
                <strong class="how-map-name">About me</strong>
                <span class="how-map-dash" aria-hidden="true">—</span>
                <span class="how-map-desc">The pianist and researcher behind the project.</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Centered final button -->
      <div class="how-cta">
        <a href="/ouverture" class="how-cta__btn">
          Start with Ouverture A <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── 3. MOVEMENTS GRID ─────────────────────────────────── -->
  <section class="section grid-section" aria-labelledby="movements-heading">
    <div class="container">
      <header class="grid-section__header">
        <h2 id="movements-heading" class="grid-section__title">Movements</h2>
        <p class="grid-section__sub">BWV 831 · French Ouverture in B minor</p>
      </header>

      <ol class="movements-grid" aria-label="List of movements">
        {movements.map((m) => (
          <li class="movements-grid__item">
            <a href={m.slug} class="movement-card" aria-label={`${m.title} — movement ${m.number}`}>
              <!-- Movement artwork image -->
              <div class="movement-card__media">
                <img
                  src={m.image}
                  alt={m.imageAlt || m.title}
                  class="movement-card__img"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="300"
                />
              </div>

              <div class="movement-card__body">
                <span class="movement-card__num" aria-hidden="true">{m.number}</span>
                <span class="movement-card__title">{m.title}</span>
                <span class="movement-card__arrow" aria-hidden="true">→</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Intro section ──────────────────────────────────────── */
  .intro-section {
    background: var(--color-cream);
    padding-block: var(--space-2xl);
  }

  .intro-section__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .intro-section__portrait {
    margin: 0;
    flex-shrink: 0;
  }

  .intro-section__portrait img {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 40px rgba(26, 23, 20, 0.12);
  }

  .intro-section__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-top: var(--space-sm);
  }

  .intro-section__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    font-weight: 300;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
  }

  .intro-section__text p {
    max-width: 60ch;
    line-height: 1.8;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
  }

  /* ── Grid section ───────────────────────────────────────── */
  .grid-section {
    background: var(--color-cream-dark);
    padding-block: var(--space-2xl);
  }

  .grid-section__header {
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .grid-section__title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 300;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .grid-section__sub {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-top: var(--space-sm);
    max-width: none;
  }

  /* Grid */
  .movements-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(26, 23, 20, 0.08);
    border: 1px solid rgba(26, 23, 20, 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .movements-grid__item {
    background: var(--color-cream);
  }

  /* Card */
  .movement-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: background var(--transition-fast);
  }

  .movement-card:hover {
    background: var(--color-cream-dark);
  }

  /* Card media & artwork image */
  .movement-card__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0d0b09;
    border-bottom: 1px solid rgba(26, 23, 20, 0.08);
    position: relative;
  }

  .movement-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .movement-card:hover .movement-card__img {
    transform: scale(1.04);
  }

  /* Card body */
  .movement-card__body {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 1rem 1.25rem;
    flex: 1;
  }

  .movement-card__num {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    min-width: 2ch;
    flex-shrink: 0;
  }

  .movement-card__title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--color-ink);
    flex: 1;
  }

  .movement-card__arrow {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .movement-card:hover .movement-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .movements-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .intro-section__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .intro-section__portrait {
      max-width: 240px;
      margin-inline: auto;
    }

    .intro-section__portrait img {
      max-width: 240px;
    }

    .movements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .movements-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── How to explore this project ────────────────────────── */
  .how-section {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-top: 1px solid rgba(26, 23, 20, 0.08);
  }

  .how-header {
    margin-bottom: var(--space-xl);
    max-width: var(--measure-wide);
  }

  .how-eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .how-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 0.85rem;
  }

  .how-subtitle {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    margin: 0;
    max-width: 58ch;
  }

  /* Steps Grid */
  .how-steps {
    list-style: none;
    margin: 0 0 var(--space-2xl) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.75rem;
  }

  .how-step {
    border-top: 1px solid rgba(26, 23, 20, 0.12);
    padding-top: 1.35rem;
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .how-step__icon {
    color: var(--color-accent);
    display: flex;
    align-items: center;
    margin-bottom: 0.85rem;
    width: 28px;
    height: 28px;
  }

  .how-step__icon svg {
    width: 22px;
    height: 22px;
  }

  .how-step__meta {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.55rem;
    flex-wrap: wrap;
  }

  .how-step__num {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1;
  }

  .how-step__sep {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  .how-step__title {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.35;
  }

  .how-step__desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* Scroll animation */
  @media (prefers-reduced-motion: no-preference) {
    .how-section[data-animated="true"] .how-step {
      opacity: 0;
      transform: translateY(12px);
    }
    .how-section[data-animated="true"].is-visible .how-step {
      opacity: 1;
      transform: translateY(0);
    }
    .how-section[data-animated="true"].is-visible .how-step:nth-child(1) { transition-delay: 40ms; }
    .how-section[data-animated="true"].is-visible .how-step:nth-child(2) { transition-delay: 110ms; }
    .how-section[data-animated="true"].is-visible .how-step:nth-child(3) { transition-delay: 180ms; }
    .how-section[data-animated="true"].is-visible .how-step:nth-child(4) { transition-delay: 250ms; }
    .how-section[data-animated="true"].is-visible .how-step:nth-child(5) { transition-delay: 320ms; }
  }

  /* Auxiliary 2-column block */
  .how-aux {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: var(--space-2xl);
  }

  .how-card {
    background: var(--color-white);
    border: 1px solid rgba(26, 23, 20, 0.08);
    border-radius: 6px;
    padding: 2.25rem 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .how-card__eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .how-card__title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0 0 0.85rem;
  }

  .how-card__text {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0 0 1.5rem;
  }

  /* Static mini illustration mimicking real version list */
  .how-demo {
    margin-top: auto;
    background: var(--color-cream);
    border: 1px solid rgba(26, 23, 20, 0.08);
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    user-select: none;
  }

  .how-demo__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    border-radius: 4px;
    background: var(--color-white);
    border: 1px solid rgba(26, 23, 20, 0.06);
  }

  .how-demo__row.is-starred {
    border-color: rgba(139, 111, 71, 0.35);
    background: rgba(196, 168, 130, 0.14);
  }

  .how-demo__label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .how-demo__pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .how-demo__name {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .how-demo__star {
    font-size: 1.05rem;
    line-height: 1;
    color: var(--color-ink-muted);
  }

  .how-demo__row.is-starred .how-demo__star {
    color: #c48b28;
  }

  /* Site map list */
  .how-map-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .how-map-item {
    margin: 0;
  }

  .how-map-link {
    display: block;
    text-decoration: none;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(26, 23, 20, 0.06);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .how-map-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .how-map-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-ink);
    margin-right: 0.35rem;
    transition: color var(--transition-fast);
  }

  .how-map-dash {
    color: var(--color-ink-muted);
    margin-right: 0.35rem;
    font-size: 0.85rem;
  }

  .how-map-desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-soft);
