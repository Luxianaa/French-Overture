---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import heroImg from "../assets/myversiosnhero.jpeg";
import { versions } from "../data/content/my-versions.js";
---

<BaseLayout
  title="My Versions — French Ouverture"
  description="Three complete readings of Bach's French Ouverture BWV 831 after the laboratory: two on piano and one on harpsichord."
>
  <Hero
    image={heroImg.src}
    title="Daniel's Versions"
    subtitle="Three readings after the laboratory"
  />

  <section
    class="section container movement-container"
    aria-label="My Versions recordings and materials"
  >
    <div class="experiments-stack">
      {
        versions.map((ver) => (
          <article
            class={`experiment-card ${ver.instrument === "harpsichord" ? "experiment-card--harpsichord" : ""}`}
            id={ver.id}
            aria-labelledby={`exp-title-${ver.id}`}
          >
            <header class="experiment-header">
              <div class="experiment-badge">
                <span
                  class={`type-dot ${ver.instrument === "harpsichord" ? "type-dot--harpsichord" : "type-dot--piano"}`}
                  aria-hidden="true"
                />
                <span class="type-label">{ver.label}</span>
              </div>
              <h2 id={`exp-title-${ver.id}`} class="experiment-title">
                {ver.title}
              </h2>
            </header>

            <div class="experiment-row">
              {/* Columna Izquierda: Vídeo y descripción */}
              <div class="experiment-col-media">
                <div class="carousel-header media-header">
                  <span class="carousel-subheading">Video</span>
                </div>
                <div class="lazy-video" data-youtube-id={ver.youtubeId}>
                  <button
                    type="button"
                    class="video-play-btn"
                    aria-label={`Play video: ${ver.title}`}
                    data-title={ver.title}
                  >
                    <img
                      src={`https://img.youtube.com/vi/${ver.youtubeId}/hqdefault.jpg`}
                      alt={`Thumbnail for ${ver.title}`}
                      loading="lazy"
                      class="video-thumbnail"
                    />
                    <div class="video-play-overlay">
                      <span class="play-icon-circle">
                        <svg
                          class="play-svg"
                          viewBox="0 0 24 24"
                          width="20"
                          height="20"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <polygon points="6 4 20 12 6 20 6 4" />
                        </svg>
                      </span>
                    </div>
                  </button>
                </div>

                {ver.description && (
                  <p class="experiment-description">{ver.description}</p>
                )}
              </div>

              {/* Columna Derecha: Dos carruseles apilados (Paintings arriba, Scores abajo) */}
              <div class="experiment-col-carousels">
                {/* Carrusel Paintings */}
                <div class="carousel-block carousel-block--paintings">
                  <div class="carousel-header">
                    <span class="carousel-subheading">Paintings</span>
                    {ver.paintings.length > 1 && (
                      <div
                        class="carousel-nav-group"
                        aria-label="Paintings carousel navigation"
                      >
                        <span
                          class="carousel-counter-text"
                          aria-live="polite"
                          aria-atomic="true"
                        >
                          1 / {ver.paintings.length}
                        </span>
                        <button
                          type="button"
                          class="carousel-circle-btn carousel__nav-btn--prev"
                          aria-label="Previous painting"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="15"
                            height="15"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="15 18 9 12 15 6" />
                          </svg>
                        </button>
                        <button
                          type="button"
                          class="carousel-circle-btn carousel__nav-btn--next"
                          aria-label="Next painting"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="15"
                            height="15"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="9 18 15 12 9 6" />
                          </svg>
                        </button>
                      </div>
                    )}
                  </div>

                  <div
                    class="carousel carousel--versions carousel--paintings"
                    aria-roledescription="carousel"
                    aria-label={`Paintings for ${ver.title}`}
                  >
                    <div
                      class="carousel__track"
                      tabindex="0"
                      role="region"
                      aria-label={`Paintings for ${ver.title}`}
                    >
                      {ver.paintings.map((p, pIdx) => (
                        <div
                          class="carousel__slide"
                          role="group"
                          aria-roledescription="slide"
                          aria-label={`${pIdx + 1} of ${ver.paintings.length}`}
                        >
                          <button
                            type="button"
                            class="carousel__image-btn"
                            aria-label={`View ${p.caption || p.alt || `artwork ${pIdx + 1}`}`}
                            data-src={p.src}
                            data-alt={p.alt}
                            data-caption={p.caption}
                            data-explanation={p.explanation}
                            data-credit={p.credit}
                            data-license={p.license || ""}
                            data-license-url={p.licenseUrl || ""}
                            data-section={p.section}
                            data-kind="painting"
                          >
                            <img
                              src={p.thumb || p.src}
                              srcset={`${p.thumb || p.src} 640w, ${p.src} 1800w`}
                              sizes="(max-width: 900px) 100vw, 50vw"
                              alt={p.alt}
                              width={p.width}
                              height={p.height}
                              loading="lazy"
                              decoding="async"
                              class="carousel__img"
                            />
                            <span
                              class="carousel__zoom-hint"
                              aria-hidden="true"
                            >
                              <svg
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                              >
                                <circle cx="11" cy="11" r="7" />
                                <line x1="16.5" y1="16.5" x2="21" y2="21" />
                                <line x1="11" y1="8" x2="11" y2="14" />
                                <line x1="8" y1="11" x2="14" y2="11" />
                              </svg>
                            </span>
                          </button>
                          <div
                            class="painting-gradient-overlay"
                            aria-hidden="true"
                          >
                            <span class="painting-section-tag">
                              {p.section}
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div
                    class="carousel-progress"
                    role="progressbar"
                    aria-valuenow="1"
                    aria-valuemin="1"
                    aria-valuemax={ver.paintings.length}
                  >
                    <div
                      class="carousel-progress__bar"
                      style={`width: ${(1 / ver.paintings.length) * 100}%`}
                    />
                  </div>
                </div>

                {/* Carrusel Scores */}
                <div class="carousel-block carousel-block--scores">
                  <div class="carousel-header">
                    <span class="carousel-subheading">Scores</span>
                    {ver.scores && ver.scores.length > 1 && (
                      <div
                        class="carousel-nav-group"
                        aria-label="Scores carousel navigation"
                      >
                        <span
                          class="carousel-counter-text"
                          aria-live="polite"
                          aria-atomic="true"
                        >
                          1 / {ver.scores.length}
                        </span>
                        <button
                          type="button"
                          class="carousel-circle-btn carousel__nav-btn--prev"
                          aria-label="Previous score"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="15"
                            height="15"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="15 18 9 12 15 6" />
                          </svg>
                        </button>
                        <button
                          type="button"
                          class="carousel-circle-btn carousel__nav-btn--next"
                          aria-label="Next score"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            width="15"
                            height="15"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="9 18 15 12 9 6" />
                          </svg>
                        </button>
                      </div>
                    )}
                  </div>

                  {ver.scores && ver.scores.length > 0 ? (
                    <div
                      class="carousel carousel--versions carousel--scores"
                      aria-roledescription="carousel"
                      aria-label={`Scores for ${ver.title}`}
                    >
                      <div
                        class="carousel__track"
                        tabindex="0"
                        role="region"
                        aria-label={`Scores for ${ver.title}`}
                      >
                        {ver.scores.map((s, sIdx) => (
                          <div
                            class="carousel__slide"
                            role="group"
                            aria-roledescription="slide"
                            aria-label={`${sIdx + 1} of ${ver.scores.length}`}
                          >
                            <button
                              type="button"
                              class="carousel__image-btn"
                              aria-label={`View ${s.caption || `score page ${sIdx + 1}`}`}
                              data-src={s.src}
                              data-alt={s.alt}
                              data-caption={s.caption}
                              data-section={`Page ${sIdx + 1}`}
                              data-kind="score"
                            >
                              <img
                                src={s.thumb || s.src}
                                alt={s.alt}
                                width={s.width}
                                height={s.height}
                                loading="lazy"
                                decoding="async"
                                class="carousel__img carousel__img--score"
                              />
                              <span
                                class="carousel__zoom-hint"
                                aria-hidden="true"
                              >
                                <svg
                                  viewBox="0 0 24 24"
                                  width="16"
                                  height="16"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                >
                                  <circle cx="11" cy="11" r="7" />
                                  <line x1="16.5" y1="16.5" x2="21" y2="21" />
                                  <line x1="11" y1="8" x2="11" y2="14" />
                                  <line x1="8" y1="11" x2="14" y2="11" />
                                </svg>
                              </span>
                            </button>
                            <div
                              class="score-gradient-overlay"
                              aria-hidden="true"
                            >
                              <span class="score-page-tag">{s.caption}</span>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div
                      class="scores-placeholder"
                      aria-label="Scores to be added"
                    >
                      <span class="scores-placeholder__text">
                        Scores to be added
                      </span>
                    </div>
                  )}

                  {ver.scores && ver.scores.length > 1 && (
                    <div
                      class="carousel-progress"
                      role="progressbar"
                      aria-valuenow="1"
                      aria-valuemin="1"
                      aria-valuemax={ver.scores.length}
                    >
                      <div
                        class="carousel-progress__bar"
                        style={`width: ${(1 / ver.scores.length) * 100}%`}
                      />
                    </div>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* Lightbox Dialog (accesible y único) */}
  <dialog
    id="my-versions-lightbox"
    class="lightbox"
    aria-labelledby="lightbox-caption"
    aria-describedby="lightbox-explanation"
  >
    <div class="lightbox__container">
      <button
        type="button"
        id="lightbox-close-btn"
        class="lightbox__close-btn"
        aria-label="Close dialog"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="lightbox__body">
        {/* Imagen a la izquierda */}
        <div class="lightbox__media">
          <button
            type="button"
            id="lightbox-prev-btn"
            class="lightbox__nav-btn lightbox__nav-btn--prev"
            aria-label="Previous item"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <img id="lightbox-img" src="" alt="" class="lightbox__img" />

          <button
            type="button"
            id="lightbox-next-btn"
            class="lightbox__nav-btn lightbox__nav-btn--next"
            aria-label="Next item"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

          <span
            id="lightbox-counter"
            class="lightbox__counter"
            aria-live="polite"
            aria-atomic="true"></span>
        </div>

        {/* Metadatos a la derecha */}
        <div class="lightbox__info">
          <span id="lightbox-section" class="lightbox__tag"></span>
          <h2 id="lightbox-caption" class="lightbox__caption"></h2>
          <p id="lightbox-explanation" class="lightbox__explanation"></p>
          <div id="lightbox-meta" class="lightbox__meta">
            <span id="lightbox-credit" class="lightbox__credit"></span>
            <span id="lightbox-license" class="lightbox__license"></span>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  /* ── Layout & Container (Mismo que /ouverture) ───────────── */
  .movement-container {
    padding-block: var(--space-2xl);
  }

  .experiments-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  /* ── Fila de versión (ExperimentCard) ───────────────────── */
  .experiment-card {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
    transition: none;
  }

  /* ── Harpsichord Variant Container ──────────────────────── */
  .experiment-card--harpsichord {
    background: color-mix(in srgb, var(--type-harpsichord) 16%, #1c1916);
    border: 1px solid
      color-mix(in srgb, var(--type-harpsichord) 35%, rgba(255, 255, 255, 0.08));
    border-left: 5px solid var(--type-harpsichord);
    border-radius: var(--radius-md);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    box-shadow: 0 10px 30px rgba(15, 12, 8, 0.16);
  }

  .experiment-card--harpsichord:hover {
    box-shadow: 0 16px 40px rgba(15, 12, 8, 0.24);
  }

  .experiment-card--harpsichord .experiment-title {
    color: var(--color-cream);
  }

  .experiment-card--harpsichord .experiment-description {
    color: rgba(245, 240, 232, 0.85);
  }

  .experiment-card--harpsichord .experiment-badge {
    background: rgba(78, 112, 88, 0.18);
    border: 1px solid rgba(78, 112, 88, 0.35);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    align-self: flex-start;
  }

  .experiment-card--harpsichord .type-label {
    color: color-mix(in srgb, var(--type-harpsichord) 75%, var(--color-cream));
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .experiment-card--harpsichord .carousel-subheading {
    color: color-mix(in srgb, var(--type-harpsichord) 80%, var(--color-cream));
  }

  .experiment-card--harpsichord .carousel-counter-text {
    color: rgba(245, 240, 232, 0.7);
  }

  .experiment-card--harpsichord .carousel-circle-btn {
    border-color: rgba(245, 240, 232, 0.25);
    color: var(--color-cream);
  }

  .experiment-card--harpsichord .carousel-circle-btn:hover {
    background: var(--color-cream);
    color: var(--color-ink);
    border-color: var(--color-cream);
  }

  .experiment-card--harpsichord .carousel-progress {
    background: rgba(255, 255, 255, 0.08);
  }

  .experiment-card--harpsichord .carousel-progress__bar {
    background: var(--type-harpsichord, #4e7058);
  }

  .experiment-card--harpsichord .carousel--scores {
    background: rgba(245, 240, 232, 0.95);
  }

  /* ── Header & Badge (Igual a /ouverture) ─────────────────── */
  .experiment-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--space-xl);
  }

  .experiment-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .type-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .type-dot--piano {
    background-color: var(--color-accent);
  }

  .type-dot--harpsichord {
    background-color: var(--type-harpsichord);
    box-shadow: 0 0 10px rgba(78, 112, 88, 0.8);
  }

  .type-label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .experiment-title {
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 2.7vw, 2.35rem);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.25;
    margin: 0;
  }

  /* ── Content Row: minmax(0, 1fr) minmax(0, 1fr), gap 3rem, align-items: start */
  .experiment-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .experiment-row > * {
    min-width: 0;
  }

  /* ── Columna Izquierda: Video & Description ─────────────── */
  .experiment-col-media {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .lazy-video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(26, 23, 20, 0.12);
  }

  .video-play-btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    display: block;
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform var(--transition-base),
      filter var(--transition-base);
  }

  .video-play-btn:hover .video-thumbnail {
    transform: scale(1.02);
    filter: brightness(0.92);
  }

  .video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 12, 8, 0.25);
    transition: background var(--transition-fast);
  }

  .video-play-btn:hover .video-play-overlay {
    background: rgba(15, 12, 8, 0.15);
  }

  .play-icon-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(245, 240, 232, 0.95);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    transition:
      transform var(--transition-fast),
      background var(--transition-fast);
  }

  .play-svg {
    width: 24px;
    height: 24px;
    margin-left: 3px;
  }

  .video-play-btn:hover .play-icon-circle {
    transform: scale(1.1);
    background: var(--color-white);
  }

  :global(.video-iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .experiment-description {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── Columna Derecha: Two Stacked Carousels ──────────────── */
  .experiment-col-carousels {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
  }

  .carousel-block {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  /* Cabecera de una línea */
  .carousel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.15rem;
    margin-bottom: 0.5rem;
    min-height: 37px;
  }

  .media-header {
    min-height: 25px;
  }

  .carousel-subheading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .carousel-nav-group {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .carousel-counter-text {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    user-select: none;
    margin-right: 0.2rem;
  }

  /* Botones circulares de 32px */
  .carousel-circle-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(26, 23, 20, 0.25);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .carousel-circle-btn:hover {
    background: var(--color-ink);
    color: var(--color-cream);
    border-color: var(--color-ink);
  }

  .carousel-circle-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Carrusel contenedor (aspect ratio y contención) ────── */
  .carousel--versions {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(26, 23, 20, 0.06);
  }

  .carousel--versions .carousel__track {
    display: flex;
