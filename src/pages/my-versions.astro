    .carousel-progress__bar {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── 1. Lazy Video & Mutual Exclusion ───────────────────────────
    const videoContainers = document.querySelectorAll(".lazy-video");

    function resetAllVideos() {
      const activeIframes = document.querySelectorAll(".lazy-video iframe");
      activeIframes.forEach((iframe) => {
        const container = iframe.closest(".lazy-video");
        iframe.remove();
        if (container) {
          const btn = container.querySelector(".video-play-btn");
          if (btn) btn.style.display = "";
        }
      });
    }

    videoContainers.forEach((container) => {
      const playBtn = container.querySelector(".video-play-btn");
      if (!playBtn) return;

      playBtn.addEventListener("click", () => {
        const youtubeId = container.getAttribute("data-youtube-id");
        if (!youtubeId || youtubeId.startsWith("TODO")) return;

        // Mutually exclusive: when one video starts, all other videos stop & return to thumbnail
        resetAllVideos();

        const iframe = document.createElement("iframe");
        iframe.setAttribute(
          "src",
          `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`,
        );
        iframe.setAttribute(
          "title",
          playBtn.getAttribute("data-title") || "YouTube video player",
        );
        iframe.setAttribute("frameborder", "0");
        iframe.setAttribute(
          "allow",
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",
        );
        iframe.setAttribute("allowfullscreen", "true");
        iframe.className = "video-iframe";

        playBtn.style.display = "none";
        container.appendChild(iframe);
      });
    });

    // ── 2. Carousels Navigation (Paintings & Scores) ─────────────────
    const carousels = document.querySelectorAll(".carousel--versions");
    carousels.forEach((carousel) => {
      const track = carousel.querySelector(".carousel__track");
      const wrapper = carousel.closest(".carousel-block");
      const prevBtn = wrapper?.querySelector(".carousel__nav-btn--prev");
      const nextBtn = wrapper?.querySelector(".carousel__nav-btn--next");
      const counterText = wrapper?.querySelector(".carousel-counter-text");
      const progressBar = wrapper?.querySelector(".carousel-progress__bar");
      const progressContainer = wrapper?.querySelector(".carousel-progress");
      const slides = carousel.querySelectorAll(".carousel__slide");
      const total = slides.length;

      if (!track || total <= 1) return;

      function updateState(index) {
        if (counterText) {
          counterText.textContent = `${index + 1} / ${total}`;
        }
        if (progressBar) {
          const pct = ((index + 1) / total) * 100;
          progressBar.style.width = `${pct}%`;
        }
        if (progressContainer) {
          progressContainer.setAttribute("aria-valuenow", String(index + 1));
        }
      }

      function getCurrentIndex() {
        const slideWidth = track.clientWidth || 1;
        return Math.round(track.scrollLeft / slideWidth);
      }

      function scrollToSlide(index) {
        const slideWidth = track.clientWidth;
        track.scrollTo({
          left: index * slideWidth,
          behavior: prefersReducedMotion ? "auto" : "smooth",
        });
        updateState(index);
      }

      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const cur = getCurrentIndex();
        const prev = (cur - 1 + total) % total;
        scrollToSlide(prev);
      });

      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const cur = getCurrentIndex();
        const next = (cur + 1) % total;
        scrollToSlide(next);
      });

      let scrollTimer;
      track.addEventListener(
        "scroll",
        () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => {
            updateState(getCurrentIndex());
          }, 40);
        },
        { passive: true },
      );

      track.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          const cur = getCurrentIndex();
          scrollToSlide((cur + 1) % total);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          const cur = getCurrentIndex();
          scrollToSlide((cur - 1 + total) % total);
        }
      });
    });

    // ── 3. Lightbox Dialog ──────────────────────────────────────────
    const dialog = document.getElementById("my-versions-lightbox");
    if (!dialog) return;

    const closeBtn = document.getElementById("lightbox-close-btn");
    const mediaContainer = dialog.querySelector(".lightbox__media");
    const lightboxImg = document.getElementById("lightbox-img");
    const prevBtn = document.getElementById("lightbox-prev-btn");
    const nextBtn = document.getElementById("lightbox-next-btn");
    const counterEl = document.getElementById("lightbox-counter");
    const sectionEl = document.getElementById("lightbox-section");
    const captionEl = document.getElementById("lightbox-caption");
    const explanationEl = document.getElementById("lightbox-explanation");
    const metaContainer = document.getElementById("lightbox-meta");
    const creditEl = document.getElementById("lightbox-credit");
    const licenseEl = document.getElementById("lightbox-license");

    let triggerElement = null;
    let activeButtons = [];
    let currentIndex = 0;

    function preloadImage(src) {
      if (!src) return;
      const img = new Image();
      img.src = src;
    }

    function updateLightbox(index) {
      if (!activeButtons.length || index < 0 || index >= activeButtons.length)
        return;
      currentIndex = index;

      const btn = activeButtons[currentIndex];
      const src = btn.getAttribute("data-src") || "";
      const alt = btn.getAttribute("data-alt") || "";
      const caption = btn.getAttribute("data-caption") || "";
      const explanation = btn.getAttribute("data-explanation") || "";
      const credit = btn.getAttribute("data-credit") || "";
      const license = btn.getAttribute("data-license") || "";
      const licenseUrl = btn.getAttribute("data-license-url") || "";
      const section = btn.getAttribute("data-section") || "";
      const total = activeButtons.length;

      if (lightboxImg) {
        lightboxImg.src = src;
        lightboxImg.alt = alt || caption || "Enlarged view";
      }

      if (sectionEl) {
        if (section) {
          sectionEl.textContent = section;
          sectionEl.style.display = "";
        } else {
          sectionEl.style.display = "none";
        }
      }

      if (captionEl) {
        captionEl.textContent = caption;
        captionEl.style.display = caption ? "" : "none";
      }

      if (explanationEl) {
        explanationEl.textContent = explanation;
        explanationEl.style.display = explanation ? "" : "none";
      }

      if (metaContainer) {
        let hasMeta = false;
        if (credit && creditEl) {
          creditEl.textContent = credit;
          creditEl.style.display = "";
          hasMeta = true;
        } else if (creditEl) {
          creditEl.style.display = "none";
        }

        if (license && licenseEl) {
          if (licenseUrl) {
            licenseEl.innerHTML = `<a href="${licenseUrl}" target="_blank" rel="noopener noreferrer">${license}</a>`;
          } else {
            licenseEl.textContent = license;
          }
          licenseEl.style.display = "";
          hasMeta = true;
        } else if (licenseEl) {
          licenseEl.style.display = "none";
        }

        metaContainer.style.display = hasMeta ? "flex" : "none";
      }

      if (total <= 1) {
        if (prevBtn) prevBtn.style.display = "none";
        if (nextBtn) nextBtn.style.display = "none";
        if (counterEl) counterEl.style.display = "none";
      } else {
        if (prevBtn) prevBtn.style.display = currentIndex > 0 ? "" : "none";
        if (nextBtn)
          nextBtn.style.display = currentIndex < total - 1 ? "" : "none";
        if (counterEl) {
          counterEl.style.display = "";
          counterEl.textContent = `${currentIndex + 1} / ${total}`;
        }
      }

      // Preload adjacent images
      if (currentIndex > 0) {
        preloadImage(activeButtons[currentIndex - 1].getAttribute("data-src"));
      }
      if (currentIndex < total - 1) {
        preloadImage(activeButtons[currentIndex + 1].getAttribute("data-src"));
      }
    }

    function showPrev() {
      if (currentIndex > 0) {
        updateLightbox(currentIndex - 1);
      }
    }

    function showNext() {
      if (currentIndex < activeButtons.length - 1) {
        updateLightbox(currentIndex + 1);
      }
    }

    // Attach click handler to each image button in paintings and scores carousels
    const imageButtons = document.querySelectorAll(
      ".carousel--versions .carousel__image-btn",
    );
    imageButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        triggerElement = btn;
        const currentCarousel = btn.closest(".carousel");
        if (!currentCarousel) return;

        // Scoped exclusively to the same carousel
        activeButtons = Array.from(
          currentCarousel.querySelectorAll(".carousel__image-btn"),
        );
        const clickedIndex = activeButtons.indexOf(btn);

        updateLightbox(clickedIndex >= 0 ? clickedIndex : 0);

        if (typeof dialog.showModal === "function") {
          dialog.showModal();
        } else {
          dialog.setAttribute("open", "");
        }

        closeBtn?.focus();
      });
    });

    closeBtn?.addEventListener("click", () => {
      dialog.close();
    });

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener("close", () => {
      if (triggerElement && typeof triggerElement.focus === "function") {
        triggerElement.focus();
      }
      triggerElement = null;
      activeButtons = [];
    });

    prevBtn?.addEventListener("click", showPrev);
    nextBtn?.addEventListener("click", showNext);

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        showPrev();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        showNext();
      }
    });

    // Touch / swipe support on mobile
    let touchStartX = 0;
    let touchStartY = 0;

    mediaContainer?.addEventListener(
      "touchstart",
      (e) => {
        const touch = e.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true },
    );

    mediaContainer?.addEventListener(
      "touchend",
      (e) => {
        const touch = e.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;

        if (
          Math.abs(deltaX) > 40 &&
          Math.abs(deltaX) > Math.abs(deltaY) * 1.5
        ) {
          if (deltaX > 0) {
            showPrev();
          } else {
            showNext();
          }
        }
      },
      { passive: true },
    );
  })();
</script>
