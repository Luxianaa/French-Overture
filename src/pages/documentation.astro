                  </header>

                  <p class="doc-description">{doc.description}</p>

                  {/* Understated Editorial Metadata */}
                  <div class="doc-meta" aria-label="Document metadata">
                    <span>PDF</span>
                    {doc.language && (
                      <>
                        <span class="doc-meta__sep" aria-hidden="true">·</span>
                        <span>{doc.language}</span>
                      </>
                    )}
                    {doc.pages && (
                      <>
                        <span class="doc-meta__sep" aria-hidden="true">·</span>
                        <span>{doc.pages} pages</span>
                      </>
                    )}
                    {doc.year && (
                      <>
                        <span class="doc-meta__sep" aria-hidden="true">·</span>
                        <span>{doc.year}</span>
                      </>
                    )}
                  </div>

                  {/* Editorial Actions */}
                  <div class="doc-actions">
                    {doc.isAvailable ? (
                      <>
                        <button
                          type="button"
                          class="doc-btn doc-btn--read doc-reader-toggle"
                          data-doc-id={doc.id}
                          aria-expanded="false"
                          aria-controls={`reader-panel-${doc.id}`}
                        >
                          <span class="doc-reader-toggle-label">Read online</span>
                        </button>

                        <a
                          href={doc.file}
                          download
                          class="doc-btn doc-btn--download"
                          aria-label={`Download ${doc.title} as PDF`}
                        >
                          Download PDF
                        </a>
                      </>
                    ) : (
                      <span class="doc-unavailable-text">Coming soon</span>
                    )}
                  </div>
                </div>
              </div>

              {/* ── Collapsible Inline Reader ── */}
              {doc.isAvailable && (
                <div
                  id={`reader-panel-${doc.id}`}
                  class="doc-reader-panel"
                  hidden
                  aria-label={`Online reader for ${doc.title}`}
                >
                  <div class="doc-reader-panel__bar">
                    <div class="doc-reader-panel__info">
                      <span class="doc-reader-panel__tag">{doc.label}</span>
                      <span class="doc-reader-panel__title">{doc.title}</span>
                    </div>

                    <div class="doc-reader-panel__controls">
                      <a
                        href={doc.file}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="doc-reader-panel__link"
                        aria-label={`Open ${doc.title} in new tab`}
                      >
                        Open in new tab ↗
                      </a>

                      <button
                        type="button"
                        class="doc-reader-panel__close"
                        data-close-target={doc.id}
                        aria-label={`Close reader for ${doc.title}`}
                      >
                        ✕ Close
                      </button>
                    </div>
                  </div>

                  <div class="doc-reader-panel__viewer">
                    <iframe
                      data-src={doc.file}
                      title={`${doc.title} — PDF Viewer`}
                      class="doc-reader-iframe"
                      loading="lazy"
                    />
                  </div>
                </div>
              )}
            </article>
          </>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
