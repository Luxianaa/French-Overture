    }

    .doc-btn {
      width: 100%;
    }

    .doc-reader-panel__viewer {
      height: 440px;
    }
  }
</style>

<script>
  // Pure JavaScript document reader controller (single active reader at any time)
  function initDocumentationReaders() {
    const toggleButtons = document.querySelectorAll(".doc-reader-toggle");
    const closeButtons = document.querySelectorAll("[data-close-target]");

    function closeAllReaders(exceptId = null) {
      toggleButtons.forEach((btn) => {
        const docId = btn.getAttribute("data-doc-id");
        if (docId !== exceptId) {
          const panel = document.getElementById(`reader-panel-${docId}`);
          if (panel) {
            panel.hidden = true;
          }
          btn.setAttribute("aria-expanded", "false");
          btn.classList.remove("is-active");
          const label = btn.querySelector(".doc-reader-toggle-label");
          if (label) {
            label.textContent = "Read online";
          }
        }
      });
    }

    toggleButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const docId = btn.getAttribute("data-doc-id");
        const panel = document.getElementById(`reader-panel-${docId}`);
        if (!panel) return;

        const isCurrentlyOpen = !panel.hidden;

        if (isCurrentlyOpen) {
          // Close this reader
          panel.hidden = true;
          btn.setAttribute("aria-expanded", "false");
          btn.classList.remove("is-active");
          const label = btn.querySelector(".doc-reader-toggle-label");
          if (label) {
            label.textContent = "Read online";
          }
        } else {
          // Close any other open reader first (single active reader constraint)
          closeAllReaders(docId);

          // Open this reader
          panel.hidden = false;
          btn.setAttribute("aria-expanded", "true");
          btn.classList.add("is-active");
          const label = btn.querySelector(".doc-reader-toggle-label");
          if (label) {
            label.textContent = "Close reader";
          }

          // Lazy load iframe source on first open
          const iframe = panel.querySelector(".doc-reader-iframe");
          if (iframe && !iframe.getAttribute("src")) {
            const dataSrc = iframe.getAttribute("data-src");
            if (dataSrc) {
              iframe.setAttribute("src", dataSrc);
            }
          }

          // Smooth scroll to reader bar if needed
          panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-close-target");
        if (targetId) {
          closeAllReaders(null);
          const toggleBtn = document.querySelector(`.doc-reader-toggle[data-doc-id="${targetId}"]`);
          if (toggleBtn) {
            toggleBtn.focus();
          }
        }
      });
    });

    // Keyboard navigation: Escape key closes any active reader
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeAllReaders(null);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDocumentationReaders);
  } else {
    initDocumentationReaders();
  }
</script>
