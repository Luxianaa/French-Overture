---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import heroImg from "../assets/chantilly.jpg";
import { documents } from "../data/content/documentation.js";

// Candidate aliases for document files in public/
const fileAliases = {
  essay: [
    "/documents/essay.pdf",
    "/documents/Daniel Porcel Chalup - A Laboratory of Doubt Against Automatic Bach MMus Project.pdf",
  ],
  score: [
    "/documents/score.pdf",
    "/documents/Scores.pdf",
  ],
  "score-annotated": [
    "/documents/score-annotated.pdf",
    "/documents/My scores.pdf",
  ],
};

// Check file availability in public/ at build/request time
const docsWithStatus = documents.map((doc) => {
  const candidates = [
    doc.file,
    ...(fileAliases[doc.id] || []),
  ].filter(Boolean);

  let resolvedFile = doc.file;
  let isAvailable = false;

  for (const candidate of candidates) {
    const relPath = candidate.replace(/^\//, "");
    const absPath = path.join(process.cwd(), "public", relPath);
    try {
      if (fs.existsSync(absPath)) {
        resolvedFile = candidate;
        isAvailable = true;
        break;
      }
    } catch (err) {
      // ignore
    }
  }

  return {
    ...doc,
    file: resolvedFile,
    isAvailable,
  };
});
---

<BaseLayout
  title="Documentation — French Ouverture"
  description="Written dissertation and performance scores for Bach's French Ouverture BWV 831."
>
  <!-- ── 1. HERO ────────────────────────────────────────────── -->
  <Hero
    image={heroImg.src}
    title="Documentation"
    subtitle="Written dissertation and performance scores"
  />

  <!-- ── 2. DOCUMENTS STACK ──────────────────────────────────── -->
  <section
    id="documents"
    class="section container docs-container"
    aria-label="Project documents and scores"
  >
    <header class="docs-section-header">
      <p class="docs-section-lead">
        The written dissertation framing this artistic research alongside the clean Urtext score and Daniel Porcel Chalup’s annotated working score from the laboratory.
      </p>
    </header>

    <div class="docs-stack">
      {
        docsWithStatus.map((doc, index) => (
          <>
            {/* Separator grouping the two scores */}
            {index === 1 && (
              <div
                class="docs-scores-divider"
                role="separator"
                aria-label="The score section"
              >
                <span class="docs-scores-divider__line" aria-hidden="true" />
                <span class="docs-scores-divider__label">The score</span>
                <span class="docs-scores-divider__line" aria-hidden="true" />
              </div>
            )}

            <article
              class={`doc-card doc-card--${doc.id} ${!doc.isAvailable ? "doc-card--unavailable" : ""}`}
              id={`card-${doc.id}`}
              aria-labelledby={`title-${doc.id}`}
            >
              <div class="doc-card__body">
                {/* ── Left Column: Typographic Cover ── */}
                <div class="doc-card__cover-col">
                  <div
                    class={`doc-cover doc-cover--${doc.id}`}
                    aria-label={`Cover for ${doc.title}`}
                  >
                    {/* ESSAY COVER — Classical Monograph */}
                    {doc.id === "essay" && (
                      <div class="doc-cover__paper doc-cover__paper--essay">
                        <div class="doc-cover__frame">
                          <header class="doc-cover__header">
                            <span class="doc-cover__institution">Royal Academy of Music</span>
                            <span class="doc-cover__affiliation">University of London</span>
                          </header>

                          <div class="doc-cover__center">
                            <h4 class="doc-cover__monograph-title">
                              A Laboratory<br />
                              of Doubt Against<br />
                              Automatic Bach
