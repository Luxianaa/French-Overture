                                d="M 46 10 L 41 10 L 41 44 L 46 44"
                                stroke="var(--color-accent)"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />

                              {/* 2. Delicate oval circling the opening dotted rhythm */}
