                              <ellipse cx="156" cy="70" rx="3.6" ry="2.5" transform="rotate(-15 156 70)" fill="currentColor" opacity="0.4" />
                              <line x1="159.5" y1="70" x2="159.5" y2="84" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              {/* ── Real Performance Markings in Accent Color ── */}
