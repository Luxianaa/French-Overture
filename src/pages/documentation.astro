                            >
                              {/* Staff 1 */}
                              <line x1="8" y1="16" x2="192" y2="16" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="22" x2="192" y2="22" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="28" x2="192" y2="28" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="34" x2="192" y2="34" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="40" x2="192" y2="40" stroke="currentColor" stroke-width="0.75" opacity="0.32" />

                              {/* Staff 2 */}
                              <line x1="8" y1="58" x2="192" y2="58" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="64" x2="192" y2="64" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="70" x2="192" y2="70" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="76" x2="192" y2="76" stroke="currentColor" stroke-width="0.75" opacity="0.32" />
                              <line x1="8" y1="82" x2="192" y2="82" stroke="currentColor" stroke-width="0.75" opacity="0.32" />

                              {/* Measure bar lines */}
                              <line x1="8" y1="16" x2="8" y2="82" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
                              <line x1="106" y1="16" x2="106" y2="82" stroke="currentColor" stroke-width="0.75" opacity="0.3" />
                              <line x1="192" y1="16" x2="192" y2="82" stroke="currentColor" stroke-width="0.75" opacity="0.3" />

                              {/* Clef & key signature hints */}
                              <path d="M 16 34 C 16 20, 24 20, 22 31 C 20 40, 14 38, 16 31 C 18 26, 20 14, 19 9" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.35" fill="none" />
                              <path d="M 28 14 L 28 26 M 31 12 L 31 24 M 26 18 L 33 16 M 26 22 L 33 20" stroke="currentColor" stroke-width="0.7" opacity="0.35" />
                              <path d="M 36 20 L 36 32 M 39 18 L 39 30 M 34 24 L 41 22 M 34 28 L 41 26" stroke="currentColor" stroke-width="0.7" opacity="0.35" />

                              {/* French Ouverture opening notes */}
                              <ellipse cx="54" cy="28" rx="3.6" ry="2.5" transform="rotate(-15 54 28)" fill="currentColor" opacity="0.4" />
                              <line x1="57.5" y1="28" x2="57.5" y2="10" stroke="currentColor" stroke-width="0.9" opacity="0.4" />
                              <circle cx="61.5" cy="28" r="1.1" fill="currentColor" opacity="0.4" />

                              <ellipse cx="72" cy="25" rx="3.4" ry="2.3" transform="rotate(-15 72 25)" fill="currentColor" opacity="0.4" />
                              <line x1="75.5" y1="25" x2="75.5" y2="10" stroke="currentColor" stroke-width="0.9" opacity="0.4" />
                              <path d="M 75.5 10 Q 80 12, 79 16" stroke="currentColor" stroke-width="0.9" fill="none" opacity="0.4" />

                              <ellipse cx="89" cy="22" rx="3.6" ry="2.5" transform="rotate(-15 89 22)" fill="currentColor" opacity="0.4" />
                              <line x1="92.5" y1="22" x2="92.5" y2="8" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

