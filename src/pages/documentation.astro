                                cx="138"
                                cy="76"
                                rx="22"
                                ry="11"
                                transform="rotate(4 138 76)"
                                stroke="var(--color-accent)"
                                stroke-width="1.5"
                                fill="rgba(139, 111, 71, 0.08)"
                              />

                              {/* 5. Pianist's fingering and dynamic marks */}
                              <text
                                x="71"
                                y="9"
                                fill="var(--color-accent)"
                                font-family="var(--font-sans)"
                                font-size="7.5"
                                font-weight="600"
                              >
                                4-5
                              </text>
                              <text
                                x="53"
                                y="50"
                                fill="var(--color-accent)"
                                font-family="var(--font-serif)"
                                font-style="italic"
                                font-size="8.5"
                              >
                                inégales
                              </text>
                              <text
                                x="114"
                                y="58"
                                fill="var(--color-accent)"
                                font-family="var(--font-serif)"
                                font-style="italic"
                                font-size="9"
                                font-weight="600"
                              >
                                p
                              </text>
                            </svg>
                          </div>

                          <footer class="doc-cover__score-footer doc-cover__score-footer--annotated">
                            <span>Annotated score</span>
                          </footer>
                        </div>
                      </div>
                    )}
                  </div>
                </div>

                {/* ── Right Column: Document Details ── */}
                <div class="doc-card__info-col">
                  <header class="doc-card__header">
                    <span class="doc-card__label">{doc.label}</span>
                    <h3 id={`title-${doc.id}`} class="doc-title">
                      {doc.title}
                    </h3>
                    {doc.subtitle && (
                      <p class="doc-subtitle">{doc.subtitle}</p>
