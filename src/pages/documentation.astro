                              <line x1="125.5" y1="19" x2="125.5" y2="6" stroke="currentColor" stroke-width="0.9" opacity="0.4" />
                              <circle cx="129.5" cy="19" r="1.1" fill="currentColor" opacity="0.4" />

                              <ellipse cx="140" cy="22" rx="3.4" ry="2.3" transform="rotate(-15 140 22)" fill="currentColor" opacity="0.4" />
                              <line x1="143.5" y1="22" x2="143.5" y2="8" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              <ellipse cx="156" cy="25" rx="3.6" ry="2.5" transform="rotate(-15 156 25)" fill="currentColor" opacity="0.4" />
                              <line x1="159.5" y1="25" x2="159.5" y2="10" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              <ellipse cx="174" cy="28" rx="3.6" ry="2.5" transform="rotate(-15 174 28)" fill="currentColor" opacity="0.4" />
                              <line x1="177.5" y1="28" x2="177.5" y2="12" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              {/* Bass notes */}
                              <ellipse cx="54" cy="64" rx="3.6" ry="2.5" transform="rotate(-15 54 64)" fill="currentColor" opacity="0.4" />
                              <line x1="57.5" y1="64" x2="57.5" y2="78" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              <ellipse cx="89" cy="70" rx="3.6" ry="2.5" transform="rotate(-15 89 70)" fill="currentColor" opacity="0.4" />
                              <line x1="92.5" y1="70" x2="92.5" y2="84" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              <ellipse cx="122" cy="76" rx="3.6" ry="2.5" transform="rotate(-15 122 76)" fill="currentColor" opacity="0.4" />
                              <line x1="125.5" y1="76" x2="125.5" y2="88" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              <ellipse cx="156" cy="70" rx="3.6" ry="2.5" transform="rotate(-15 156 70)" fill="currentColor" opacity="0.4" />
                              <line x1="159.5" y1="70" x2="159.5" y2="84" stroke="currentColor" stroke-width="0.9" opacity="0.4" />
