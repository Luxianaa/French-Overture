                              <ellipse cx="174" cy="28" rx="3.6" ry="2.5" transform="rotate(-15 174 28)" fill="currentColor" opacity="0.4" />
                              <line x1="177.5" y1="28" x2="177.5" y2="12" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

