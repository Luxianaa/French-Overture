                              <line x1="57.5" y1="64" x2="57.5" y2="78" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              <ellipse cx="89" cy="70" rx="3.6" ry="2.5" transform="rotate(-15 89 70)" fill="currentColor" opacity="0.4" />
                              <line x1="92.5" y1="70" x2="92.5" y2="84" stroke="currentColor" stroke-width="0.9" opacity="0.4" />

                              <ellipse cx="122" cy="76" rx="3.6" ry="2.5" transform="rotate(-15 122 76)" fill="currentColor" opacity="0.4" />
